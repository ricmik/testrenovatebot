{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":disableRateLimiting"
  ],
  "timezone": "Europe/Oslo",
  "schedule": ["every weekend"],
  "enabledManagers": [
    "kubernetes",
    "helmv3",
    "helm-values",
    "argocd",
    "flux",
    "github-actions",
    "terraform"
  ],

  "registryAliases": {
    "internal.harbor.no/ghcrcache": "ghcr.io"
  },

  "kubernetes": {
    "fileMatch": ["\\.ya?ml$"]
  },
  "helm-values": {
    "fileMatch": ["(^|/)values.*\\.ya?ml$"]
  },

  "packageRules": [
    {
      "description": "Grupper minor + patch for alle Docker-images",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docker images (minor/patch)"
    },
    {
      "description": "Major-oppdateringer skal alltid være egne PR-er og krever manuell godkjenning",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["renovate"],
  "commitMessagePrefix": "chore(deps):"
}

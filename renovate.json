{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":disableRateLimiting"
  ],
  "timezone": "Europe/Oslo",
  "schedule": ["every weekend"],
  "enabledManagers": [
    "kubernetes",
    "kustomize",
    "helmv3",
    "helm-values",
    "argocd",
    "flux",
    "github-actions",
    "terraform",
    "regex"
  ],

  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],

  "registryAliases": {
    "internal.harbor.no/ghcrcache": "ghcr.io"
  },

  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values.*\\.ya?ml$/"
    ]
  },

  "packageRules": [
    {
      "description": "Grupper minor + patch for alle Docker-images",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docker images (minor/patch)"
    },
    {
      "description": "Major-oppdateringer skal alltid være egne PR-er og krever manuell godkjenning",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["renovate"],
  "commitMessagePrefix": "chore(deps):",

  "customManagers": [
    {
      "description": "Pick up helm chart versions from ArgoCD kustomize version patches",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)version\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: registryUrl=(?<registryUrl>[^\\s]+) chart=(?<depName>[^\\s]+)\\n\\s+targetRevision: \"?(?<currentValue>[^\"\\n]+)\"?"
      ],
      "datasourceTemplate": "helm"
    }
  ],
  "regexManagers": [
    {
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        " +targetRevision: +(?<currentValue>[^'\" ]+) +# renovate: depName=(?<depName>[^ \\n]+) +(extractVersion=(?<extractVersion>[^\\n]+))?"
      ]
    }
  ]
}
